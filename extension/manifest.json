{
  "manifest_version": 3,
  "name": "Aether Agent",
  "version": "1.0.0",
  "description": "Powerful AI-powered personal browser agent. Sidebar chatbot with deep web search, OCR, memory, and automated document generation.",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Aether Agent Sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
